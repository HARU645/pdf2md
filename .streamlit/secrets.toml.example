# 이 파일을 secrets.toml 로 복사해서 쓰세요.
# secrets.toml 은 git에 올라가지 않습니다.
#
# 배포한 앱에 넣을 때는 호스팅 사이트의 Secrets 설정 화면에 붙여넣으면 됩니다.

# 비밀번호. 비워두거나 지우면 잠금 없이 누구나 열 수 있습니다.
# 폴더 경로를 입력받는 앱이므로, 바깥에 공개할 때는 반드시 설정하세요.
password = "원하는-비밀번호"

# 화면에 처음 채워질 폴더 경로. 없어도 되고, 그러면 빈 칸으로 시작합니다.
source_folder = "C:\myfiles\pdf"
output_folder = "C:\myfiles\markdown"
